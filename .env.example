# GEMINI_API_KEY: Optional for future AI features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Server-side HMAC secret for signing session & short-lived file URLs.
# Leave unset in preview to use a secure ephemeral in-memory random secret per boot.
SESSION_SECRET=

# ASHCLOUD_TARGET_CAPACITY_TB: Platform target storage capacity in decimal TB.
ASHCLOUD_TARGET_CAPACITY_TB="512"
